#include "jisplit89.dtsi"

&default_transform {
    col-offset = <0>;
};

&kscan0 {
    col-gpios
        = <&gpio0 29 GPIO_ACTIVE_HIGH> // F4 -> P0.29
        , <&gpio0 2 GPIO_ACTIVE_HIGH>  // F5 -> P0.02
        , <&gpio1 15 GPIO_ACTIVE_HIGH> // F6 -> P1.15
        , <&gpio1 13 GPIO_ACTIVE_HIGH> // F7 -> P1.13
        , <&gpio0 20 GPIO_ACTIVE_HIGH> // B1 -> P0.20
        , <&gpio1 4 GPIO_ACTIVE_HIGH>  // B3 -> P1.04
        , <&gpio0 17 GPIO_ACTIVE_HIGH> // B2 -> P0.17
        , <&gpio0 9 GPIO_ACTIVE_HIGH>  // B5 -> P0.09
        ;
};
