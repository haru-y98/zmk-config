#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <14>;
        // 89-key split keyboard mapped according to QMK keyboard.json
        // Left side: matrix rows 0-6, cols 0-7
        // Right side: matrix rows 7-13, cols 0-7
        map = <
// Physical Row 0 (top row): ESC(0,0), F1(0,1)-F5(0,5), F6(7,0), F7(7,1), F8(7,2), F9(7,3), F10(7,4), F11(7,5), F12(7,6), Ins(7,7), PrtSc(13,0)
RC(0,0)  RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                     RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(7,5) RC(7,6) RC(7,7) RC(13,0)
// Physical Row 1: Zenkaku(1,0), 1(1,1)-5(1,5), 6(8,0)-0(8,4), -(8,5), ^(8,6), Yen(8,7), BS(13,1), Del(13,2)
RC(1,0)  RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                     RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4) RC(8,5) RC(8,6) RC(8,7) RC(13,1) RC(13,2)
// Physical Row 2: Tab(2,0), Q(2,1), W(2,2), E(2,3), R(2,4), T(2,5), Y(9,0), U(9,1), I(9,2), O(9,3), P(9,4), @(9,5), [(9,6), Enter(9,7), Home(13,3)
RC(2,0)  RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                     RC(9,0) RC(9,1) RC(9,2) RC(9,3) RC(9,4) RC(9,5) RC(9,6) RC(9,7)          RC(13,3)
// Physical Row 3: Caps(3,0), A(3,1), S(3,2), D(3,3), F(3,4), G(3,5), H(10,0), J(10,1), K(10,2), L(10,3), ;(10,4), :(10,5), ](10,6), End(10,7)
RC(3,0)  RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                     RC(10,0) RC(10,1) RC(10,2) RC(10,3) RC(10,4) RC(10,5) RC(10,6)          RC(10,7)
// Physical Row 4: LShift(4,0), Z(4,1), X(4,2), C(4,3), V(4,4), B(4,5), N(11,0), M(11,1), ,(11,2), .(11,3), /(11,4), \(11,5), PgDn(11,6), Up(11,7), PgUp(12,7)
RC(4,0)  RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)                     RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(11,5) RC(11,6) RC(11,7) RC(12,7)
// Physical Row 5: LCtrl(5,0), LWin(5,1), LAlt(5,2), Muhenkan(5,3), Space(5,4), Space(5,5), Space(12,0), Space(12,1), Henkan(12,2), Kana(12,3), App(12,4), Left(12,5), Down(12,6), Right(13,4)
RC(5,0)  RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)                     RC(12,0) RC(12,1) RC(12,2) RC(12,3) RC(12,4)          RC(12,5) RC(12,6) RC(13,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D1
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D0
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D4
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // C6
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D7
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // E6
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // B4
            ;
        // col-gpios defined in left/right overlays
    };
};
