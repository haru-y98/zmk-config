#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <14>;
        // 89キー分割キーボード
        // 左側: Row 0-6, Col 0-7
        // 右側: Row 7-13, Col 0-7
        map = <
// Row 0 (15キー): ESC, F1-F5, F6-F12, Insert, Delete
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                     RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(7,5) RC(7,6) RC(7,7) RC(13,0)
// Row 1 (16キー): Grave, 1-5, 6-0, -, =, YEN, Backspace, Home
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                     RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4) RC(8,5) RC(8,6) RC(8,7) RC(13,1) RC(13,2)
// Row 2 (15キー): Tab, Q-T, Y-P, [, ], \, PgUp
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                     RC(9,0) RC(9,1) RC(9,2) RC(9,3) RC(9,4) RC(9,5) RC(9,6) RC(9,7)          RC(13,3)
// Row 3 (14キー): Ctrl, A-G, H-L, ;, ', Enter, PgDn
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                     RC(10,0) RC(10,1) RC(10,2) RC(10,3) RC(10,4) RC(10,5) RC(10,6)           RC(10,7)
// Row 4 (15キー): Shift, Z-B, N-/, RO, RShift, Up, End
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)                     RC(11,0) RC(11,1) RC(11,2) RC(11,3) RC(11,4) RC(11,5) RC(11,6) RC(11,7) RC(12,7)
// Row 5 (14キー): Adjust, Win, Alt, HENKAN, Space, MUHENKAN, Space, KANA, RAlt, RCtrl, RWin, Left, Down, Right
RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)                     RC(12,0) RC(12,1) RC(12,2) RC(12,3) RC(12,4)          RC(12,5) RC(12,6) RC(13,4)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D1 (P0.06)
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D0 (P0.08)
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D4 (P0.22)
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // C6 (P1.00)
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // D7 (P0.11)
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // E6 (P0.24)
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // B4 (P1.06)
            ;

        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH> // F4 (P0.29)
            , <&pro_micro 20 GPIO_ACTIVE_HIGH> // F5 (P0.02)
            , <&pro_micro 19 GPIO_ACTIVE_HIGH> // F6 (P1.15)
            , <&pro_micro 18 GPIO_ACTIVE_HIGH> // F7 (P1.13)
            , <&pro_micro 15 GPIO_ACTIVE_HIGH> // B1 (P0.20)
            , <&pro_micro 14 GPIO_ACTIVE_HIGH> // B3 (P1.04)
            , <&pro_micro 16 GPIO_ACTIVE_HIGH> // B2 (P0.17)
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>  // B5 (P0.09)
            ;
    };
};
