#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <7>;
        // Jisplit89: 89キー分割キーボード
        // 左側: Col 0-7, 右側: Col 8-15
        map = <
// Row 0 (左:6キー, 右:9キー = 15キー): ESC, F1-F5 | F6-F12, Insert, Delete
RC(0,0)         RC(0,1) RC(0,2) RC(0,3) RC(0,4)         RC(0,5)                                         RC(0,8) RC(0,9) RC(0,10)        RC(0,11) RC(0,12) RC(0,13) RC(0,14)        RC(0,15) RC(6,8)
// Row 1 (左:6キー, 右:10キー = 16キー): Grave, 1-5 | 6-0, -, =, YEN, Backspace, Home
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                         RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(6,9) RC(6,10)
// Row 2 (左:6キー, 右:9キー = 15キー): Tab, Q-T | Y-P, [, ], \, PgUp
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                                         RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)          RC(6,11)
// Row 3 (左:6キー, 右:8キー = 14キー): Ctrl, A-G | H-L, ;, ', Enter, PgDn
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                                         RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14)           RC(3,15)
// Row 4 (左:6キー, 右:9キー = 15キー): Shift, Z-B | N-/, RO, RShift, Up, End
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)                                         RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(5,15)
// Row 5 (左:6キー, 右:8キー = 14キー): Adjust, Win, Alt, HENKAN, Space, Space | MUHENKAN, KANA, RAlt, RCtrl, RWin, Left, Down, Right
RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)                                         RC(5,8) RC(5,9) RC(5,10) RC(5,11) RC(5,12)          RC(5,13) RC(5,14) RC(6,12)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&pro_micro 20 GPIO_ACTIVE_HIGH>
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>
            , <&pro_micro 17 GPIO_ACTIVE_HIGH>
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>
            , <&pro_micro 12 GPIO_ACTIVE_HIGH>
            ;
    };
};
